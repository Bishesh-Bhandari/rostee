# rostee configuration
# Copy this file to `.env` and fill in the values below:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (macOS / Linux)
# Never commit `.env`: it holds your secrets.

# Gemini API key (required). Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Everything else has a working default. To tune something, look up its
# field in app/config.py and add it here in UPPER_CASE, e.g. RERANK_TOP_K=8
#   LLM model ........... "LLM" section
#   answer quality ...... "Retrieval" section (retrieve_top_k, rerank_top_k)
#   chunk size .......... "Chunking" section
#   storage folders ..... "Storage" section
